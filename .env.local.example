NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed to run scripts/import-inventory.ts (npm run import:inventory).
# Bypasses RLS — an admin/server-side secret, never used by the app itself,
# never exposed to the browser (no NEXT_PUBLIC_ prefix). Find it in
# Project Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
